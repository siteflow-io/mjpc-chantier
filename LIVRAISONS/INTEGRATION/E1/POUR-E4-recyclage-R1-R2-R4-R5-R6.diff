+:is(#dr-zone,#ses-tab,.at-som-volet) .mur .dr-mkbout{position:absolute;width:11px;height:11px;transform:translate(-50%,-50%);background:rgba(255,255,255,.35);border:2px solid #d1495b;border-radius:50%;cursor:move;z-index:3}
+:is(#dr-zone,#ses-tab,.at-som-volet) .mur .dr-mkbout.dr-mksel{background:#d1495b}
+:is(#dr-zone,#ses-tab,.at-som-volet) .mur .dr-mkpoi{position:absolute;right:-6px;bottom:-6px;width:10px;height:10px;background:#fff;border:2px solid #d1495b;border-radius:2px;cursor:nwse-resize}
+body.dr-pose-mk :is(#dr-zone,#ses-tab,.at-som-volet) .mur .img-sup{cursor:crosshair;outline:2px dashed var(--or);outline-offset:2px}
+/* E1 (F17) le paragraphe d'une fiche porte la classe « corps » de la maquette, comme le conteneur de la mise en page (grille à trois colonnes) : il en héritait la grille — et, dans la colonne unique (--lg:0), son texte s'écrasait lettre par lettre */
+:is(#dr-zone,#ses-tab,.at-som-volet) .mur .fiche .corps{display:block;grid-template-columns:none;grid-template-rows:none;flex:none;min-height:0}
+/* E1 (R14) la fiche ouverte : ses paragraphes se dévoilent (pâles au pilote, absents au tableau) ; ⤢ pour l'ouvrir, ✕ pour la refermer */
+:is(#dr-zone,#ses-tab,.at-som-volet) .mur.pilote .f-tab .pas{opacity:.45}
+:is(#dr-zone,#ses-tab,.at-som-volet) .mur.tableau .f-tab .pas{visibility:hidden}
+:is(#dr-zone,#ses-tab,.at-som-volet) .mur .dr-fiche-ouvrir{float:right;font:inherit;font-size:.5em;line-height:1.2;padding:.15em .5em;border:1px solid #c9b48a;border-radius:6px;background:#fffdf7;color:#6a5a48;cursor:pointer}
+:is(#dr-zone,#ses-tab,.at-som-volet) .mur .dr-fiche-fermer{position:absolute;top:.4em;right:.4em;font:inherit;font-size:.6em;width:1.8em;height:1.8em;border:1px solid #c9b48a;border-radius:50%;background:#fffdf7;color:#6a5a48;cursor:pointer;z-index:3}
+/* E1 (R5) la sélection multiple de l'atelier */
+:is(#dr-zone,#ses-tab,.at-som-volet) .mur .dr-sel{outline:2px solid #0f8f53;outline-offset:2px;background:rgba(15,143,83,.08)}
+#dr-zone .dr-selbar{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);z-index:60;display:flex;gap:8px;align-items:center;background:var(--carte,#fffdf9);color:var(--texte,#22303f);border:1px solid var(--bord2,#d9cdb4);border-radius:10px;padding:8px 12px;box-shadow:0 6px 24px rgba(0,0,0,.25);font-size:.9rem;white-space:nowrap}
+/* E1 (R2) « ↻ Rappel » au-dessus d'une fiche déjà posée dans le chapitre (l'ancien moteur, .rap) */
+:is(#dr-zone,#ses-tab,.at-som-volet) .dr-rap{align-self:flex-start;display:inline-block;background:#eef4fa;color:#2f5b84;border:1px solid #b9d0e6;border-radius:999px;padding:.12em .55em;font-size:.42em;letter-spacing:.04em;margin-bottom:.2em}
+:is(#dr-zone,#ses-tab,.at-som-volet) .dr-rap.dr-edit{cursor:pointer}
+:is(#dr-zone,#ses-tab,.at-som-volet) .dr-rap.dr-edit:hover{background:#dceaf6}
 /* E1 (R21) l'aperçu de l'image dans la modale du site (hors #dr-zone : la modale est au site) */
 #at-modale .dr-saisie-apercu{display:none;max-width:100%;max-height:160px;margin-top:8px;border-radius:6px}
 #at-modale .dr-saisie-manque{font-size:.85em;color:#a33;margin-top:4px}


