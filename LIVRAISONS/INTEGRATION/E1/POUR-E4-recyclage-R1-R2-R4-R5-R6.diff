await B('A16', 'les marques sur une image (recyclage R1) : poser (point, flèche, cadre, étiquette), glisser, écrire, supprimer, « une à une » ; dans B/deroule, et rechargées', async () => {
  const o = await E.ouvrir(b); const pg = o.pg; await sansVoile(pg);
