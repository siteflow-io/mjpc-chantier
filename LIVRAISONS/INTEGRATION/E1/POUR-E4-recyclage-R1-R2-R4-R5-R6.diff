  const ecrit = () => pg.evaluate(() => { const d = window.__CORPS.filter(x => /seances\/0\/deroule$/.test(x.c)).pop(); return d ? d.bd.ecrans.map(e => e.eid).join(',') : null; });
  const e0 = await eids(); const d0 = await dis();
  await pg.click('#volet [data-at-di="1"]'); await pg.waitForTimeout(200); await pg.mouse.click(5, 5);
  await pg.keyboard.press('Control+d'); await pg.waitForTimeout(300); const e1 = await eids();
  await pg.keyboard.press('Alt+ArrowDown'); await pg.waitForTimeout(1500); const e2 = await eids(); const w2 = await ecrit();
  E.verif('A12', d0 && !(await dis()) && e1 !== e0 && e2 !== e1 && w2 && e2.startsWith(w2), 'avant toute modification ↶ est grisé ; Ctrl+D puis Alt+↓ : deux crans, la trame modifiée s\'écrit', 'grisé ' + d0);
  await pg.keyboard.press('Control+z'); await pg.waitForTimeout(300); const e3 = await eids();
  E.verif('A12', e3 === e1, 'Ctrl+Z : le déplacement est défait, la copie reste');
  await pg.click('#at-annuler'); await pg.waitForTimeout(1500); const e4 = await eids(); const w4 = await ecrit();
  E.verif('A12', e4 === e0 && (await dis()) && w4 && e0.startsWith(w4), '↶ : la copie est défaite, la trame d\'origine revient et s\'écrit ; plus rien à annuler, ↶ grisé', w4 && w4.slice(0, 60));
  await pg.keyboard.press('Control+z'); await pg.waitForTimeout(300);
  E.verif('A12', (await eids()) === e0 && !o.errs.length && !o.boites.length, 'un Ctrl+Z de trop : rien ne bouge, aucune erreur JS, aucune boîte du navigateur', (o.errs.concat(o.boites)).join(' ; ') || undefined); await o.ctx.close(); });


