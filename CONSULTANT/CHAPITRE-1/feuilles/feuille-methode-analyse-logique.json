 "valeurs": {
  "titre": {
   "texte": "Fiche méthode : l'analyse logique en 4 étapes"
  },
  "sous_titre": {
   "texte": "Les quatre étapes, à apprendre par cœur."
  },
  "objectif": {
   "texte": "À la fin de cette leçon, tu sauras appliquer les quatre étapes de l'analyse logique sur une phrase."
  },
  "competences": {
   "items": [
    "Construire les notions permettant l'analyse et l'élaboration des textes et des discours"
   ]
  },
  "notions": {
   "items": [
    "Phrase simple et phrase complexe",
    "La proposition subordonnée relative",
    "La proposition subordonnée conjonctive"
   ]
  },
  "domaine_socle": {
   "texte": "Domaine 1 — Les langages pour penser et communiquer"
  },
  "criteres_je": {
   "items": [
    "je sais réciter les quatre étapes dans l'ordre",
    "je sais souligner tous les verbes conjugués",
    "je sais poser les crochets et nommer chaque proposition",
    "je sais relier le mot subordonnant à son antécédent"
   ]
  },
  "travail_a_faire": {
   "texte": "Apprends les quatre étapes par cœur, puis analyse une phrase de ton choix dans un texte du chapitre."
  },
  "explicitation_but": {
   "texte": "Les quatre étapes s'apprennent par cœur et s'appliquent toujours dans cet ordre. Une cinquième étape s'ajoutera plus tard dans l'année : dire quelle fonction le pronom relatif occupe dans sa proposition, et quelle fonction la subordonnée occupe dans la phrase."
  }
 },
